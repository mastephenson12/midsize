{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "roofers.midsizeai.com"
        }
      ],
      "destination": "/roofers-robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "roofers.midsizeai.com"
        }
      ],
      "destination": "/roofers-sitemap.xml"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "roofers.midsizeai.com"
        }
      ],
      "destination": "/roofers"
    },
    {
      "source": "/missed-lead-calculator",
      "destination": "/calculator"
    },
    {
      "source": "/missed-lead-calculator/",
      "destination": "/calculator"
    },
    {
      "source": "/missed-lead-audit",
      "destination": "/"
    },
    {
      "source": "/missed-lead-audit/",
      "destination": "/"
    },
    {
      "source": "/missed-call-calculator",
      "destination": "/calculator"
    },
    {
      "source": "/missed-call-calculator/",
      "destination": "/calculator"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
